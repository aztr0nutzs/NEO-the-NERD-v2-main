# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Node / Next.js
node_modules
.next/
out/
tsconfig.tsbuildinfo

# Alternative package manager lockfiles (canonical: package-lock.json / npm)
pnpm-lock.yaml
yarn.lock

# OS
.DS_Store
Thumbs.db

# Editor / IDE swap files
*.swp
*.swo

# JetBrains / Android Studio IDE metadata (machine-specific; never commit).
# Tracking these caused recurring "Invalid Gradle JDK configuration" problems
# because each clone's JDK path / gradleJvm differs.
.idea/
**/.idea/
*.iml

# Gradle local caches / wrapper state (machine-specific)
.gradle/
**/.gradle/

# Local Android SDK / NDK paths (machine-specific)
local.properties
**/local.properties

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Harness / agent state (not product code)
.omx/
