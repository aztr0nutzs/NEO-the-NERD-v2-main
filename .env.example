# --------------------------------------------------------------------------
# Server-side OpenAI configuration for NEO assistant chat and TTS.
# These are READ ONLY by the Next.js server routes (`app/api/...`).
# Do NOT expose them with NEXT_PUBLIC_. Do NOT commit real secrets.
# --------------------------------------------------------------------------
OPENAI_API_KEY=

# Optional model overrides used by the assistant chat route.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TEMPERATURE=0.75
OPENAI_MAX_OUTPUT_TOKENS=650

# --------------------------------------------------------------------------
# Runtime transport configuration (read by the browser).
# --------------------------------------------------------------------------
# Base URL of the hosted Next.js (or compatible) backend that exposes
# the `/api/assistant/chat` and `/api/tts` route handlers. When set, the
# in-app transport client (lib/runtime/backend-client.ts) targets this
# URL for ALL backend requests instead of same-origin /api/*.
#
# When to set:
#  - Capacitor / Android packaged builds: REQUIRED for live AI + provider TTS.
#    Without it the app gracefully degrades to the local browser-side response
#    engine and disables provider TTS generation.
#  - Hosted Next.js on a different origin: optional override.
#  - Local Next.js dev: leave blank to use same-origin /api/*.
NEXT_PUBLIC_NEO_BACKEND_BASE_URL=
# IMPORTANT: Android APK builds without NEXT_PUBLIC_NEO_BACKEND_BASE_URL cannot
# reach Next.js server routes from the packaged WebView. Voice previews will
# fall back to Android device TTS and profiles may sound identical.
# Rebuild and resync Android after changing this value:
# npm run build && npx cap sync android

# Optional explicit build-target hint. The transport layer also auto-detects
# Capacitor at runtime via `Capacitor.isNativePlatform()`, but build pipelines
# may set this to "static" to force static-export semantics.
# Allowed values: "static" | "server" | <unset>
NEXT_PUBLIC_NEO_BUILD_TARGET=

# --------------------------------------------------------------------------
# Optional native/local network discovery backend (existing).
# --------------------------------------------------------------------------
NEXT_PUBLIC_NEO_NETWORK_BACKEND_URL=
# Optional external OmniVoice Python/FastAPI backend URL.
# Must expose GET /health and POST /tts. Used by Android/web client at runtime.
# Emulator local service: http://10.0.2.2:8011
# Physical phone: use the PC LAN IP, not 127.0.0.1.
# /health must be ready and /tts must return real playable audio.
NEXT_PUBLIC_OMNIVOICE_BASE_URL=
